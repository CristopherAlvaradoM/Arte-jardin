---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/Navbar.astro";
import { getCollection } from "astro:content";
import Contactanos from "../../components/Contactanos.astro";

export async function getStaticPaths() {
  const proyectos = await getCollection("proyectos");
  return proyectos.map((proyecto) => ({
    params: { id: proyecto.slug },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
const { data } = proyecto;
---

<Layout>
  <Navbar
    phoneNumber="523334420435"
    message="Hola, me gustaría más información sobre sus servicios."
  />
  <header
    class="mb-10 relative h-screen flex flex-col items-center justify-center text-white overflow-hidden"
  >
    <!-- Imagen de fondo -->
    <div class="absolute inset-0">
      <img
        src={data.heroImage}
        alt="Fondo"
        class="w-full h-full object-cover brightness-50 pointer-events-none"
      />
    </div>

    <!-- Contenido centrado -->
    <div class="relative z-10 text-center">
      <h1
        class="text-5xl sm:text-7xl md:text-8xl font-medium font-secondary px-6 sm:p-16"
      >
        {data.title}
      </h1>
    </div>
  </header>
  <div class="container mx-auto px-4 py-12 max-w-5xl font-primary">
    <div class="space-y-12 mb-16">
      <section>
        <h3 class="text-3xl font-secondary text-gray-900 mb-4">
          {data.vision.title}
        </h3>
        <p class="text-lg text-gray-700 leading-relaxed font-primary">
          {data.vision.body}
        </p>
      </section>

      <section>
        <h3 class="text-3xl font-secondary text-gray-900 mb-4">
          {data.philosophy.title}
        </h3>
        <p class="text-lg text-gray-700 leading-relaxed font-primary">
          {data.philosophy.body}
        </p>
      </section>

      <section>
        <h2 class="text-4xl font-secondary text-gray-900 mb-8">
          {data.challenge.title}
        </h2>

        <div class="mb-8">
          <h3 class="text-2xl font-medium text-gray-800 mb-3 font-secondary">
            {data.challenge.intro.title}
          </h3>
          <p class="text-lg text-gray-700 leading-relaxed font-primary">
            {data.challenge.intro.body}
          </p>
        </div>

        <div>
          {
            data.challenge.items.map(
              (item: { title: unknown; body: unknown }) => (
                <div class="mb-4">
                  <h3 class="text-2xl font-medium text-gray-800 mb-3 font-secondary">
                    {item.title}
                  </h3>
                  <p class="text-lg text-gray-700 leading-relaxed mb-4 font-primary">
                    {item.body}
                  </p>
                </div>
              ),
            )
          }
          <p class="text-lg text-gray-700 leading-relaxed font-primary">
            {data.challenge.conclusion}
          </p>
        </div>
      </section>
    </div>

    <div class="relative flex items-center justify-center mb-16">
      <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-gray-300"></div>
      </div>
      <div class="relative bg-white px-4">
        <span class="text-xl text-gray-500 font-secondary italic"
          >Galería del Proyecto</span
        >
      </div>
    </div>

    <h2
      class="text-3xl md:text-4xl font-secondary text-center text-gray-900 mb-12"
    >
      {data.gallery.title}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-6 gap-4">
      <!-- Row 1: 3 images (2 cols each) -->
      {
        data.gallery.images
          .slice(0, 3)
          .map((img: string | null | undefined, index: number) => (
            <div class="md:col-span-2 h-64 md:h-80">
              <img
                src={img}
                alt={`Vista del jardín ${index + 1}`}
                class="w-full h-full object-cover shadow-md hover:shadow-xl transition-shadow duration-300"
              />
            </div>
          ))
      }

      <!-- Row 2: 2 images (3 cols each) -->
      {
        data.gallery.images
          .slice(3, 5)
          .map((img: string | null | undefined, index: number) => (
            <div class="md:col-span-3 h-64 md:h-80">
              <img
                src={img}
                alt={`Vista del jardín ${index + 4}`}
                class="w-full h-full object-cover shadow-md hover:shadow-xl transition-shadow duration-300"
              />
            </div>
          ))
      }

      <!-- Row 3: 3 images (2 cols each) -->
      {
        data.gallery.images
          .slice(5, 8)
          .map((img: string | null | undefined, index: number) => (
            <div class="md:col-span-2 h-64 md:h-80">
              <img
                src={img}
                alt={`Vista del jardín ${index + 6}`}
                class="w-full h-full object-cover shadow-md hover:shadow-xl transition-shadow duration-300"
              />
            </div>
          ))
      }

      <!-- Row 4: 1 image (6 cols) -->
      {
        data.gallery.images
          .slice(8, 9)
          .map((img: string | null | undefined, index: number) => (
            <div class="md:col-span-6 h-64 md:h-96">
              <img
                src={img}
                alt={`Vista del jardín ${index + 9}`}
                class="w-full h-full object-cover shadow-md hover:shadow-xl transition-shadow duration-300"
              />
            </div>
          ))
      }
    </div>
  </div>
  <section class="px-6 md:px-10 py-8 md:py-16">
    <Contactanos
      phoneNumber="523334420435"
      message="Hola, me gustaría más información sobre sus servicios."
    />
  </section>
  <Footer />
</Layout>
